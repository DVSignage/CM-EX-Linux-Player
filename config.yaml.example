# CM:EX Linux Player — configuration
#
# Copy this file to config.yaml and edit the values below.
# The player searches for config.yaml in:
#   1. ./config.yaml  (current working directory)
#   2. /etc/signage-player/config.yaml
#   3. ~/.config/signage-player/config.yaml
#
# Player identity (player_id, player_secret) is stored automatically in
# ~/.config/signage-player/state.json after enrollment.

# CMS server base URL. Leave it out to enter the address on the screen
# instead (the setup screen, which also offers edge mode).
cms_url: "http://cms-server:8000"

# Connection mode (optional): "cloud" (default) talks to cms_url directly;
# "edge" talks to a site edge server first and fails over to cms_url.
# connection_mode: "edge"
# edge_url: "http://10.0.0.5:8080"

# Playback settings (optional — defaults shown)
playback:
  # X display the player draws on
  display: ":0"
  # Audio output device for mpv — "auto" lets mpv choose
  audio_output: "auto"
  # Default duration in seconds for images when the playlist item has duration=0
  default_image_duration: 10
  # "auto": the renderer page in Chromium when installed (templates, walls,
  # crossfades, capture); "mpv": mpv only
  renderer: "auto"
  # A small spinner while content loads
  loading_indicator: false
  # The animated wave behind the audio Now Playing card
  music_wave: true

# Control API on port 8083 (optional): lets sensors, touch panels and show
# controllers on the LAN drive interactive walls (/api/trigger, /api/scene...).
# Off: this machine only. A trigger_key makes LAN and browser callers send it as
# the X-Trigger-Key header.
lan_api:
  enabled: false
  trigger_key: ""

# Cache (optional): how many recent playlists stay cached, so switching back
# to one needs no re-download (1-100)
cache:
  keep_playlists: 10

# Log verbosity: DEBUG, INFO, WARNING, ERROR
log_level: "INFO"
