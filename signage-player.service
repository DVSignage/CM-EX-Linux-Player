[Unit]
Description=Digital Signage Player Daemon
# With the desktop, after the display manager (not After=graphical.target: with
# WantedBy=graphical.target that is an ordering cycle and the start is dropped).
After=network-online.target display-manager.service
Wants=network-online.target

[Service]
Type=simple
User=signage
Group=signage
WorkingDirectory=/opt/signage-player
ExecStart=/usr/bin/python3 /opt/signage-player/main.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# Environment
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/signage/.Xauthority"

# Security. With a snap Chromium (Ubuntu) set this to false: snap-confine is
# setuid and refuses to start under NoNewPrivileges (install.sh does this itself).
NoNewPrivileges=true
PrivateTmp=true
# the X server's sockets: shared, or the player cannot see the display
BindPaths=-/tmp/.X11-unix

[Install]
WantedBy=graphical.target
